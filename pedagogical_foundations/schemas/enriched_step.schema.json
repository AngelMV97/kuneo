{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuneo.app/schemas/enriched_step.schema.json",
  "title": "Enriched Module Step",
  "description": "Validation schema for module_steps after OpenAI enrichment. Ensures all required fields are present and properly structured.",
  "type": "object",
  "required": [
    "step_id",
    "module_id",
    "step_number",
    "cognitive_type",
    "title",
    "instruction",
    "content",
    "expected_response_type",
    "success_criteria",
    "hint_policy",
    "feedback_policy",
    "estimated_time_seconds",
    "difficulty"
  ],
  "properties": {
    "step_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the step (UUID)"
    },
    "module_id": {
      "type": "string",
      "format": "uuid",
      "description": "Foreign key to modules table"
    },
    "step_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Order within module (1-8)"
    },
    "cognitive_type": {
      "type": "string",
      "enum": [
        "exploracion",
        "representacion",
        "razonamiento",
        "clasificacion",
        "aplicacion_guiada",
        "transferencia",
        "analisis_de_error",
        "metacognicion"
      ],
      "description": "Cognitive dimension of this step"
    },
    "session_type": {
      "type": "string",
      "enum": ["guided", "practice", "challenge", "remedial"],
      "description": "Optional: type of learning session"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "description": "Short title for the step (5-100 chars)"
    },
    "instruction": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Main instruction for the student (10-500 chars, max 2-3 sentences)"
    },
    "content": {
      "type": "object",
      "required": ["prompt", "options", "correct_answer"],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "The actual question or task prompt (ENRICHED by LLM)"
        },
        "context": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional: contextual setup for the question"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-F]$",
                "description": "Option identifier (A-F)"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Option text"
              },
              "misconception": {
                "type": "string",
                "maxLength": 100,
                "description": "If this is a distractor, which misconception does it represent?"
              }
            }
          },
          "description": "Answer options (for multiple_choice)"
        },
        "correct_answer": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Correct answer(s) - can be single string or array"
        },
        "explanation": {
          "type": "string",
          "maxLength": 300,
          "description": "Why this answer is correct (max 300 chars)"
        },
        "input_mode": {
          "type": "string",
          "enum": ["multiple_choice", "open_text", "numeric", "drag_drop", "drawing", "selection", "voice"],
          "description": "How student provides answer"
        }
      },
      "description": "The enriched content JSONB (generated by LLM)"
    },
    "expected_response_type": {
      "type": "string",
      "enum": ["multiple_choice", "open_text", "numeric", "drag_drop", "drawing", "selection", "voice", "none"],
      "description": "Type of response expected from student"
    },
    "success_criteria": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["exact_match", "contains", "range", "pattern", "rubric"],
          "description": "How to evaluate success"
        },
        "value": {
          "description": "Expected value (string, number, array, or regex pattern)"
        },
        "partial_credit": {
          "type": "boolean",
          "description": "Whether partial credit is allowed"
        }
      },
      "description": "Criteria for success"
    },
    "concept_card_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Optional: linked concept_card for Tuko intervention"
    },
    "visual_template_key": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9_]+$",
      "description": "Optional: linked visual_template"
    },
    "hint_policy": {
      "type": "object",
      "required": ["hint_level_1"],
      "properties": {
        "hint_level_1": {
          "type": "string",
          "maxLength": 150,
          "description": "Short guiding hint (max 35 words, ENRICHED by LLM)"
        },
        "hint_level_2": {
          "type": "string",
          "maxLength": 200,
          "description": "More explicit hint or visual reference (ENRICHED by LLM)"
        },
        "worked_example": {
          "type": "string",
          "maxLength": 500,
          "description": "Step-by-step worked example (ENRICHED by LLM)"
        },
        "visual_hint": {
          "type": "string",
          "description": "Reference to visual_template_key with overlay or highlight instructions"
        }
      },
      "description": "Progressive hints JSONB (ENRICHED by LLM)"
    },
    "feedback_policy": {
      "type": "object",
      "required": ["correct_feedback"],
      "properties": {
        "correct_feedback": {
          "type": "string",
          "maxLength": 100,
          "description": "Feedback for correct answer (max 20 words, ENRICHED by LLM)"
        },
        "incorrect_feedback": {
          "type": "string",
          "maxLength": 150,
          "description": "Generic feedback for incorrect answer (max 25 words, ENRICHED by LLM)"
        },
        "misconception_feedback": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 150
          },
          "description": "Specific feedback by misconception (ENRICHED by LLM)"
        },
        "partial_feedback": {
          "type": "string",
          "maxLength": 150,
          "description": "Feedback for partial correctness"
        }
      },
      "description": "Feedback variants JSONB (ENRICHED by LLM)"
    },
    "next_step_logic": {
      "type": "object",
      "properties": {
        "on_success": {
          "type": "string",
          "enum": ["next_step", "skip_ahead", "challenge", "reflection"],
          "description": "What happens if student succeeds"
        },
        "on_failure": {
          "type": "string",
          "enum": ["retry", "hint", "remedial", "skip"],
          "description": "What happens if student fails"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Max attempts before intervention"
        }
      },
      "description": "Adaptive branching logic"
    },
    "estimated_time_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600,
      "description": "Expected time to complete (30-600 seconds)"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Difficulty level (1=easy, 5=very hard)"
    }
  },
  "additionalProperties": false,
  
  "examples": [
    {
      "step_id": "123e4567-e89b-12d3-a456-426614174000",
      "module_id": "123e4567-e89b-12d3-a456-426614174001",
      "step_number": 1,
      "cognitive_type": "exploracion",
      "session_type": "guided",
      "title": "Observa las partes coloreadas",
      "instruction": "Mira la imagen y cuenta cuántas partes están coloreadas.",
      "content": {
        "prompt": "¿Cuántas partes del círculo están coloreadas?",
        "context": "María dividió un pastel redondo en 4 partes iguales y sirvió 1 pedazo.",
        "options": [
          {"id": "A", "text": "1 de 4"},
          {"id": "B", "text": "4 de 1", "misconception": "confunde numerador con denominador"},
          {"id": "C", "text": "1 de 2", "misconception": "no cuenta todas las partes"},
          {"id": "D", "text": "2 de 4", "misconception": "cuenta mal las partes coloreadas"}
        ],
        "correct_answer": "A",
        "explanation": "Hay 1 parte coloreada de un total de 4 partes iguales, por lo tanto 1/4.",
        "input_mode": "multiple_choice"
      },
      "expected_response_type": "multiple_choice",
      "success_criteria": {
        "type": "exact_match",
        "value": "A",
        "partial_credit": false
      },
      "concept_card_id": "concept_fractions_basic",
      "visual_template_key": "fraction_part_whole",
      "hint_policy": {
        "hint_level_1": "Cuenta primero cuántas partes hay en total.",
        "hint_level_2": "Luego cuenta solo las partes que están coloreadas.",
        "worked_example": "Si un círculo tiene 4 partes y 1 está coloreada, la fracción es 1/4 (una de cuatro).",
        "visual_hint": "fraction_part_whole with overlay highlighting 1 colored part"
      },
      "feedback_policy": {
        "correct_feedback": "Correcto. Identificaste 1 parte coloreada de 4 en total.",
        "incorrect_feedback": "Revisa cuántas partes hay en total y cuántas están coloreadas.",
        "misconception_feedback": {
          "confunde_numerador_denominador": "El numerador (arriba) indica las partes coloreadas. El denominador (abajo) indica el total de partes.",
          "no_cuenta_todas_las_partes": "Asegúrate de contar todas las partes del círculo, no solo las coloreadas."
        }
      },
      "next_step_logic": {
        "on_success": "next_step",
        "on_failure": "hint",
        "max_attempts": 3
      },
      "estimated_time_seconds": 90,
      "difficulty": 1
    }
  ]
}
