# Copy the values from your existing server/.env. Never put privileged keys in client/.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
PORT=3001
NODE_ENV=development
OPENAI_MODEL=gpt-4o-mini
# Independent routes: changing activity generation must not change answer grading.
OPENAI_ACTIVITY_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
OPENAI_EVALUATION_MODEL=gpt-4.1-mini
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
# Remove redundant output only; retain data, rubric, rationales and review.
LEARNING_ACTIVITY_COMPACT=true
# Optional paid Fast mode, measured but NOT enabled by default.
# OPENAI_ACTIVITY_SERVICE_TIER=fast
# Prepare a single next activity after answers and while reading a practice summary.
LEARNING_PREFETCH=true
# One unpublished next candidate while reading/answering, only when all possible
# outcomes agree on the next target. false keeps only post-answer prefetch.
LEARNING_LOOKAHEAD=true
# generated (default): live personalized activities, stored reserve on failure.
# stored: use only existing evaluable reserve content; no billing/trial quotas.
LEARNING_CONTENT_MODE=generated
# Optional stable random secret. If absent, the backend derives encryption from
# SUPABASE_SERVICE_ROLE_KEY. Changing either invalidates pending activity tokens.
LEARNING_ACTIVITY_SECRET=
