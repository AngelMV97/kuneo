"""
generate_all_modules.py

Script para generar el catálogo completo de módulos basado en curriculum_taxonomy.
Genera módulos para todas las materias y todos los rangos de grado.

IMPORTANTE:
    - Ejecutar DESPUÉS de cargar curriculum_taxonomy
    - La tabla modules debe estar vacía o se crearán duplicados
    - Toma ~5-10 minutos para generar ~1,570 módulos

Uso:
    python scripts/generators/generate_all_modules.py

Autor: Sistema Kuneo
Fecha: 2026-05-12
"""

import time
from module_generator import ModuleGenerator


def generate_complete_catalog():
    """Genera el catálogo completo de módulos."""
    
    print("=" * 70)
    print("🏗️  GENERACIÓN MASIVA DE MÓDULOS DE KUNEO")
    print("=" * 70)
    print("\nEste proceso generará módulos para:")
    print("   - 5 materias: Matemáticas, Ciencias, Sociales, Lenguaje, Inglés")
    print("   - 5 rangos de grado: 1-3, 4-5, 6-7, 8-9, 10-11")
    print("   - ~1,570 módulos en total")
    print("\n⏱️  Tiempo estimado: 5-10 minutos")
    print("=" * 70)
    
    # Confirmar
    confirm = input("\n¿Deseas continuar? (s/n): ").strip().lower()
    if confirm != 's':
        print("❌ Operación cancelada")
        return
    
    # Inicializar generador
    generator = ModuleGenerator()
    
    # Definir materias y rangos
    subjects = [
        "matematicas",
        "ciencias_naturales",
        "ciencias_sociales",
        "lenguaje",
        "ingles"
    ]
    
    grade_ranges = ["1-3", "4-5", "6-7", "8-9", "10-11"]
    
    # Contadores
    total_created = 0
    total_failed = 0
    start_time = time.time()
    
    # Generar por materia y grado
    for subject in subjects:
        subject_start = time.time()
        subject_created = 0
        
        for grade_range in grade_ranges:
            modules = generator.generate_modules_for_subject(
                subject=subject,
                grade_range=grade_range
            )
            
            subject_created += len(modules)
            total_created += len(modules)
        
        subject_time = time.time() - subject_start
        print(f"\n📊 {subject}: {subject_created} módulos en {subject_time:.1f}s")
    
    # Tiempo total
    total_time = time.time() - start_time
    
    # Mostrar resumen final
    print("\n" + "=" * 70)
    print("✅ GENERACIÓN COMPLETADA")
    print("=" * 70)
    print(f"\n📊 Resumen:")
    print(f"   Módulos creados: {total_created}")
    print(f"   Módulos fallidos: {total_failed}")
    print(f"   Tiempo total: {total_time / 60:.1f} minutos")
    print(f"   Velocidad: {total_created / total_time:.1f} módulos/segundo")
    
    # Mostrar estadísticas detalladas
    print("\n")
    generator.print_statistics()
    
    print("\n" + "=" * 70)
    print("🎉 Catálogo de módulos generado exitosamente")
    print("=" * 70)
    print("\nPróximos pasos:")
    print("   1. Verificar módulos en Supabase: kuneo.modules")
    print("   2. Probar módulos en el frontend")
    print("   3. Implementar generador de contenido (ejercicios, hints, feedback)")


def generate_subset():
    """Genera un subconjunto de módulos para pruebas."""
    
    print("=" * 70)
    print("🧪 GENERACIÓN DE PRUEBA")
    print("=" * 70)
    print("\nGenerando ~100 módulos para testing:")
    print("   - Matemáticas: grados 4-5")
    print("   - Ciencias: grados 6-7")
    print("=" * 70)
    
    generator = ModuleGenerator()
    
    # Matemáticas 4-5
    math_modules = generator.generate_modules_for_subject(
        subject="matematicas",
        grade_range="4-5"
    )
    
    # Ciencias 6-7
    science_modules = generator.generate_modules_for_subject(
        subject="ciencias_naturales",
        grade_range="6-7"
    )
    
    total = len(math_modules) + len(science_modules)
    
    print(f"\n✅ {total} módulos de prueba generados")
    generator.print_statistics()


def main():
    """Función principal."""
    print("\n¿Qué deseas hacer?")
    print("   1. Generar catálogo COMPLETO (~1,570 módulos)")
    print("   2. Generar SUBSET de prueba (~100 módulos)")
    print("   3. Cancelar")
    
    choice = input("\nElige una opción (1/2/3): ").strip()
    
    if choice == "1":
        generate_complete_catalog()
    elif choice == "2":
        generate_subset()
    else:
        print("❌ Operación cancelada")


if __name__ == "__main__":
    main()
